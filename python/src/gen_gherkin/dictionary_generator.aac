generator:
    name: Dictionary File Generator
    description: A component diagram generation action for Gen-dictionary-file command.
    sources:
        - name: Dictionary Steps diagram
          data_source: acceptance
          templates:
            - name: Dictionary File
              description: Generates a dictionary file based on model data.
              template_file: ./dictionary.json.jinja2
              overwrite: OVERWRITE
              output_target: CODE
              output_file_suffix: _dictionary
              output_file_extension: json
