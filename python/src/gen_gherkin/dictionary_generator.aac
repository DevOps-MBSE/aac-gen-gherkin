generator:
    name: Dictionary Step Generator
    description: A JSON generation action for the gen-dictionary-step command in the Gen-Gherkin plugin.
    sources:
        - name: Dictionary Step JSON
          data_source: dictionary
          templates:
            - name: Dictionary Steps JSON
              description: Generates a JSON file based on model data.
              template_file: ./dictionary_step.jinja2
              overwrite: OVERWRITE
              output_target: CODE
              output_file_extension: json
